bouldering_wall "Wall#10" {     // # is not alphanumeric.

  routes [
    bouldering_route "Route-10" {       // - is not alphanumeric.

      grade: "7A",
      grid_base_point {x: 0, y: 0},
      holds ["0001", "0002"]
    }
  ],
  volumes [
    circle {
      pos: {x: 0, y: 0},
      depth: 10,
      radius: 50,
      front_holds [
        hold "0001" { 
            pos: {x: 1, y: 1}, 
            shape: "1", 
            colours [white] 
        },
        hold "0002" { 
            pos: {x: 2, y: 2}, 
            shape: "2", 
            colours [white] 
        }
      ],
      side_holds []
    }
  ]
}