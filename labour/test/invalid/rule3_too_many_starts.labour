  ],
  volumes [
    circle {
      pos: { x: 50, y: 50 }, depth: 10, radius: 20,
      front_holds [
        hold "0001" { pos: { x: 0, y: 0 }, shape: "1", colours [ blue ], start_hold: 1 },
        hold "0002" { pos: { x: 5, y: 5 }, shape: "2", colours [ blue ], start_hold: 2 },
        hold "0003" { pos: { x: 10, y: 10 }, shape: "3", colours [ blue ], start_hold: 1 }
      ]
    }
  ]
}