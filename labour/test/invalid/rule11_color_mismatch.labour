bouldering_wall "Invalid Wall 3" {
  routes [
    bouldering_route "Mismatch Route" {
      grade: "7A",
      grid_base_point { x: 0, y: 0 },
      holds [ "0001", "0002" ] 
    }
  ],
  volumes [
    circle {
      pos: { x: 50, y: 50 }, depth: 10, radius: 20,
      front_holds [
        hold "0001" { pos: { x: 0, y: 0 }, shape: "1", colours [ red, yellow ] },
        hold "0002" { pos: { x: 10, y: 10 }, shape: "2", colours [ blue, green ] }
      ]
    }
  ]
}